# RouteShield Environment Configuration

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5000

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_string

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/routeshield
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/routeshield?retryWrites=true&w=majority

# Routing & Geocoding Providers
# Nominatim (OpenStreetMap geocoder) - Requires a descriptive User-Agent
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RouteShield-SaferRoutePlanner/1.0 (contact@routeshield.local)

# OSRM (Open Source Routing Machine)
# Public demo endpoint or self-hosted instance
OSRM_BASE_URL=https://router.project-osrm.org

# Overpass API (for verified public infrastructure, e.g., streetlights, lit sidewalks)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Upload Configuration
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIRECTORY=uploads
